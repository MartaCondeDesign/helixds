{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-owner-gate-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Helix owner gate"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-contract-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Helix contracts read?"
          }
        ]
      },
      {
        "matcher": "mcp__.*use_figma",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-figma-props-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Helix Figma properties"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-lint-hook.mjs\"",
            "timeout": 60,
            "statusMessage": "Helix lint"
          }
        ]
      },
      {
        "matcher": "mcp__.*use_figma",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-figma-mirror-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "Helix: both Figma files"
          }
        ]
      }
    ]
  }
}
