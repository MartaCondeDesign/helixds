{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://helixds.design/contracts/component.schema.json",
  "title": "Helix Component Contract",
  "description": "Framework-agnostic contract describing what a Helix component IS. Not how it's implemented.",
  "type": "object",
  "required": [
    "name",
    "version",
    "purpose",
    "states",
    "anatomy",
    "props",
    "tokenPolicy"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "PascalCase component name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "beta",
        "stable",
        "deprecated"
      ]
    },
    "purpose": {
      "type": "string",
      "description": "One sentence: what this component is for. Written from the user's perspective."
    },
    "import": {
      "type": "string",
      "pattern": "^import \\{ .+ \\} from '@helixds/react';$",
      "description": "The exact import statement an app uses. Generated from packages/core/src/index.ts by pnpm docs:contract-imports — do not hand-edit."
    },
    "neverUseFor": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anti-patterns: what this component must never be used for."
    },
    "rationale": {
      "type": "string",
      "description": "Architectural rationale: why key decisions, constraints, or trade-offs were made."
    },
    "governance": {
      "type": "object",
      "description": "Decision authority boundaries: what agents/consumers may extend locally vs what must escalate to Helix DS.",
      "properties": {
        "mayExtendLocally": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Permitted local customizations using // [CUSTOM] reason."
        },
        "mustEscalateToDS": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Changes that alter shared contracts and must escalate to a Helix DS proposal/ADR."
        }
      }
    },
    "states": {
      "type": "object",
      "properties": {
        "intrinsic": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "States the browser manages (hover, focus, active). Never build as props."
        },
        "authored": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "aria": {
                "type": "string",
                "description": "ARIA attribute set when this state is active"
              }
            }
          },
          "description": "States managed by the component as props (loading, disabled, invalid)."
        }
      }
    },
    "anatomy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "part",
          "element",
          "description"
        ],
        "properties": {
          "part": {
            "type": "string",
            "description": "data-helix-part value"
          },
          "element": {
            "type": "string",
            "description": "HTML element or 'slot'"
          },
          "description": {
            "type": "string"
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Canonical prop name from prop-map.md"
          },
          "type": {
            "type": "string",
            "description": "TypeScript type as string"
          },
          "default": {
            "type": [
              "string",
              "boolean",
              "number",
              "null"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "tokenPolicy": {
      "type": "object",
      "description": "Which token categories this component uses. CI checks compliance.",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Token prefixes allowed in this component's CSS (e.g. 'color.fill', 'spacing')"
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Token prefixes explicitly forbidden (e.g. 'primitive.color.brand' — use semantic alias instead)"
        }
      }
    },
    "a11y": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "keyboardNav": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wcag": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "announces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ARIA roles a screen reader must hear for this component, checked against each story's accessibility tree (Playwright ariaSnapshot) by verify:stable criterion 4. Optional: when absent, the first ARIA role named in `role` is used. [] = announces no role of its own (e.g. a layout wrapper whose landmark only applies in a real page)."
        },
        "humanReview": {
          "type": "array",
          "description": "Record of hands-on reviews with real assistive technology — what automated checks can't judge (does the announcement make sense, is the order natural). Newest last.",
          "items": {
            "type": "object",
            "required": [
              "date",
              "by",
              "with"
            ],
            "properties": {
              "date": {
                "type": "string",
                "description": "YYYY-MM-DD"
              },
              "by": {
                "type": "string",
                "description": "Who reviewed"
              },
              "with": {
                "type": "string",
                "description": "Assistive technology + browser, e.g. 'VoiceOver + Safari 26'"
              },
              "result": {
                "type": "string",
                "enum": [
                  "pass",
                  "issues"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "results": {
          "type": "object",
          "description": "Written by `pnpm a11y` — do not hand-edit. The latest result of every accessibility check for this component, its score (% of the automatic checks that apply and pass) and whether it meets every one. Reviews (ai-visual, human) are listed but never scored (root CLAUDE.md rule 14). `changed` is the date the results last changed.",
          "properties": {
            "score": {
              "type": [
                "number",
                "null"
              ]
            },
            "meetsMinimum": {
              "type": "boolean"
            },
            "changed": {
              "type": "string"
            },
            "checks": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "n/a",
                  "pending"
                ]
              }
            },
            "notScored": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sizing": {
      "type": "object",
      "description": "Physical size mapping. See ADR-004 for the shared control/field scale and documented exceptions.",
      "properties": {
        "height": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "fixed",
                "rows-driven"
              ]
            },
            "values": {
              "type": "object",
              "description": "size key -> px number"
            },
            "unit": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "width": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string",
              "enum": [
                "hug",
                "fill",
                "fixed"
              ]
            },
            "modes": {
              "type": "object"
            },
            "minWidth": {
              "type": [
                "number",
                "null"
              ]
            },
            "maxWidth": {
              "type": [
                "number",
                "null"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "figma": {
          "type": "object",
          "description": "Figma auto-layout sizing metadata for this component."
        }
      }
    },
    "figma": {
      "type": "object",
      "description": "Figma side of the contract. Code stays the source of truth for what the component IS; this section only records how it is represented in Figma — including properties that exist ONLY in the design file (figmaOnly), like the `state` axis that shows hover/press/focus, which code expresses as CSS pseudo-classes rather than props.",
      "properties": {
        "fileId": {
          "type": "string"
        },
        "componentId": {
          "type": "string"
        },
        "lastSync": {
          "type": "string",
          "format": "date"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every value the Figma `state` variant axis must have. scripts/figma/audit-component.js fails the component when one is missing. Derived from states.intrinsic (hover, focus, active→press) + the authored states that change the look (disabled, invalid...). Empty for non-interactive components (e.g. Badge)."
        },
        "properties": {
          "type": "array",
          "description": "Figma component properties that differ from the code props: figma-only ones (state) and code props represented differently in Figma (e.g. a boolean that must be a VARIANT because it changes layout).",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "VARIANT",
                  "BOOLEAN",
                  "TEXT",
                  "INSTANCE_SWAP"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "figmaOnly": {
                "type": "boolean",
                "description": "true = exists only in Figma, there is no code prop with this name (e.g. state: hover/press/focus are CSS pseudo-classes in code)."
              },
              "codeProp": {
                "type": "string",
                "description": "The code prop(s) this represents, when it isn't figma-only."
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
