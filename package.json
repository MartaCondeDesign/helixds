{
  "name": "helixds",
  "private": true,
  "version": "0.1.0",
  "description": "Helix Design System — AI-ready, built on native HTML elements + Tailwind v4 + Tabler Icons",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "sb": "pnpm --dir apps/storybook dev",
    "dev:wc": "pnpm --dir apps/wc-sandbox dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps",
    "lint:stories": "eslint apps/storybook/stories/Components apps/storybook/stories/Layout",
    "test": "pnpm -r test",
    "verify:contract": "tsx scripts/verify-contract.ts",
    "verify:a11y-contracts": "tsx scripts/verify-a11y-contracts.ts",
    "a11y": "tsx scripts/a11y.ts",
    "a11y:contract": "tsx scripts/a11y.ts contract",
    "a11y:keys": "tsx scripts/a11y.ts keys",
    "a11y:focus-return": "tsx scripts/a11y.ts focus-return",
    "a11y:keyboard": "tsx scripts/a11y.ts keyboard",
    "a11y:axe": "tsx scripts/a11y.ts axe",
    "a11y:contrast": "tsx scripts/a11y.ts contrast",
    "a11y:focus-visible": "tsx scripts/a11y.ts focus-visible",
    "a11y:target-size": "tsx scripts/a11y.ts target-size",
    "a11y:reflow": "tsx scripts/a11y.ts reflow",
    "a11y:screen-reader": "tsx scripts/a11y.ts screen-reader",
    "a11y:ai-visual": "tsx scripts/a11y.ts ai-visual",
    "a11y:human": "tsx scripts/a11y.ts human",
    "a11y:visual": "tsx scripts/a11y-visual-review.ts",
    "a11y:review": "tsx scripts/a11y-human-review.ts",
    "verify:dtcg": "tsx scripts/verify-dtcg.ts",
    "verify:tokens": "tsx scripts/verify-token-naming.ts",
    "verify:props": "tsx scripts/prop-map-check.ts",
    "verify:icons": "tsx scripts/verify-icon-usage.ts",
    "verify:types": "tsx scripts/verify-types.ts",
    "verify:stable": "tsx scripts/verify-stable.ts",
    "test:storybook-tokens": "pnpm -s --filter @helixds/tokens build >/dev/null && tsx --tsconfig apps/storybook/tsconfig.json --test scripts/storybook-tokens.test.ts",
    "verify:storybook-tokens": "tsx --tsconfig apps/storybook/tsconfig.json scripts/verify-storybook-tokens.ts",
    "verify:governance": "tsx scripts/verify-governance.ts",
    "test:lint-hook": "node --test scripts/claude-lint-hook.test.mjs",
    "test:contract-hook": "node --test scripts/claude-contract-hook.test.mjs",
    "test:owner-gate-hook": "node --test scripts/claude-owner-gate-hook.test.mjs",
    "test:figma-props-hook": "node --test scripts/claude-figma-props-hook.test.mjs",
    "test:setup-ai": "node --test scripts/setup-ai.test.mjs",
    "test:mcp-installed": "node --test packages/mcp/test/installed.test.mjs",
    "test:traces": "node --test scripts/hook-trace.test.mjs",
    "test:hook-agents": "node --test scripts/hook-agents.test.mjs",
    "report:paints": "tsx scripts/report-paints.ts",
    "lint:ai": "tsx scripts/lint-ai.ts",
    "docs:token-exceptions": "tsx scripts/audit-token-exceptions.ts",
    "audit:token-usage": "tsx scripts/audit-token-usage.ts",
    "docs:manifest": "tsx scripts/generate-component-manifest.ts",
    "docs:contract-imports": "tsx scripts/sync-contract-imports.ts",
    "docs:changelog": "tsx scripts/generate-changelog.ts",
    "docs:changelog:md": "tsx scripts/generate-changelog.ts --md",
    "docs:figma-map": "tsx scripts/docs-figma-map.ts",
    "docs:readme": "tsx scripts/generate-readme-stats.ts",
    "contract": "tsx scripts/contract-cli.ts",
    "helix": "tsx scripts/helix-cli.ts",
    "helix:mcp": "tsx packages/mcp/src/server.ts",
    "generate:types": "tsx scripts/generate-types.ts",
    "token:add": "tsx scripts/token-cli.ts",
    "eval:run": "tsx scripts/eval-run.ts",
    "eval:generate": "tsx scripts/eval-generate.ts",
    "eval:report": "tsx scripts/eval-report.ts",
    "eval:pr": "tsx scripts/eval-pr.ts",
    "eval:review": "tsx scripts/eval-review.ts",
    "eval:gallery": "tsx scripts/eval-gallery.ts",
    "proof": "tsx packages/proof/src/cli.ts",
    "proof:serve": "tsx packages/proof/src/cli.ts --serve --no-build",
    "eval:ladder": "tsx scripts/eval-ladder.ts",
    "eval:rescore": "tsx scripts/eval-rescore.ts",
    "eval:calibrate": "tsx scripts/eval-calibrate.ts",
    "readiness": "tsx scripts/ai-readiness.ts",
    "eval:judge": "tsx scripts/eval-judge.ts",
    "eval:trace": "tsx scripts/log-trace.ts",
    "eval:traces": "node scripts/eval-traces.mjs",
    "quality": "tsx scripts/quality-cli.ts",
    "setup:ai": "node scripts/setup-ai.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "prepare": "husky && tsx scripts/generate-changelog.ts",
    "figma:expected": "tsx scripts/figma/expected-styles.ts",
    "figma:audit": "tsx scripts/figma/audit-rest.ts",
    "changeset": "changeset",
    "release": "pnpm -r --filter './packages/*' build && node scripts/release-publish.mjs",
    "release:first": "pnpm release",
    "release:dry": "pnpm -r --filter './packages/*' build && node scripts/release-publish.mjs --dry-run",
    "figma:props": "tsx scripts/figma/props.ts",
    "figma:snapshot": "tsx scripts/figma/snapshot.ts",
    "figma:story-order": "tsx scripts/figma/story-order.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@helixds/eslint-plugin": "workspace:^",
    "@types/node": "^20.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "husky": "^9.1.7",
    "playwright": "1.63.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.0"
  }
}
