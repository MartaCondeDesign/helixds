{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target":           "ES2022",
    "lib":              ["ES2022", "DOM", "DOM.Iterable"],
    "module":           "ESNext",
    "moduleResolution": "bundler",
    "jsx":              "react-jsx",
    "strict":           true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true,
    "skipLibCheck":     true
  }
}
