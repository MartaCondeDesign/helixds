{
  "name": "@helixds/react",
  "version": "0.1.0",
  "description": "Helix DS core components — native HTML elements + Tailwind CSS v4",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./globals.css": "./src/globals.css",
    "./contracts/*": "./dist/contracts/*.json",
    "./prop-map.md": "./dist/prop-map.md",
    "./AGENTS.md": "./dist/AGENTS.md"
  },
  "files": [
    "dist",
    "src/globals.css"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/copy-agent-docs.mjs",
    "dev": "tsc --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@helixds/tokens": "workspace:*",
    "@tabler/icons-react": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "echarts": "^6.1.0",
    "motion": "13.2.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "*"
  }
}
