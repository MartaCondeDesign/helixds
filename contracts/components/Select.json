{
  "$schema": "../component.schema.json",
  "name": "Select",
  "version": "1.0.0",
  "status": "stable",

  "purpose": "Lets users choose a single value from a predefined list.",

  "neverUseFor": [
    "Free-form text entry - use Input instead",
    "Multiple simultaneous selections - use MultiSelect or CheckboxGroup",
    "Large option catalogs with search - use Combobox"
  ],

  "states": {
    "intrinsic": ["hover", "focus", "active", "open"],
    "authored": [
      { "name": "invalid", "description": "The selected value fails validation.", "aria": "aria-invalid='true'" },
      { "name": "disabled", "description": "The field is non-interactive.", "aria": "disabled (native)" },
      { "name": "required", "description": "The field must have a value before form submission.", "aria": "aria-required='true'" }
    ]
  },

  "anatomy": [
    { "part": "select-root", "element": "div", "description": "Layout wrapper for label, field, and messages." },
    { "part": "select-label", "element": "label", "description": "Accessible label. Always rendered - visible or sr-only." },
    { "part": "select-wrapper", "element": "div", "description": "Positions the native control and chevron." },
    { "part": "select-trigger", "element": "select", "description": "Native select control." },
    { "part": "select-chevron", "element": "slot", "description": "Trailing chevron icon.", "optional": true },
    { "part": "select-description", "element": "span", "description": "Helper text below the field.", "optional": true },
    { "part": "select-error", "element": "span", "description": "Error text shown when invalid=true.", "optional": true }
  ],

  "props": [
    { "name": "label", "type": "string", "required": true, "description": "Visible or screen-reader-only label. Required for a11y." },
    { "name": "options", "type": "(SelectOption | SelectOptionGroup)[]", "required": true, "description": "List of options and grouped options." },
    { "name": "value", "type": "string | undefined", "description": "Controlled selected value." },
    { "name": "defaultValue", "type": "string | undefined", "description": "Uncontrolled initial value." },
    { "name": "onChange", "type": "(value: string) => void | undefined", "description": "Value change handler." },
    { "name": "placeholder", "type": "string | undefined", "description": "Placeholder option shown before a selection." },
    { "name": "description", "type": "string | undefined", "description": "Helper text shown below the field." },
    { "name": "errorMessage", "type": "string | undefined", "description": "Error text shown when invalid=true." },
    { "name": "invalid", "type": "boolean", "default": false, "description": "Shows error styling and message." },
    { "name": "disabled", "type": "boolean", "default": false, "description": "Non-interactive state." },
    { "name": "required", "type": "boolean", "default": false, "description": "Marks field as required." },
    { "name": "fullWidth", "type": "boolean", "default": false, "description": "Expands to container width." },
    { "name": "hideLabel", "type": "boolean", "default": false, "description": "Hides the label visually but keeps it accessible." },
    { "name": "size", "type": "'s' | 'm' | 'l'", "default": "m", "description": "Field size. Uses the shared field scale." },
    { "name": "id", "type": "string | undefined", "description": "Optional field id override." }
  ],

  "sizing": {
    "height": {
      "mode": "fixed",
      "values": { "s": 32, "m": 36, "l": 40 },
      "unit": "px",
      "note": "Shared field scale. Keep these values aligned with Input and Textarea density docs."
    },
    "width": {
      "default": "hug",
      "modes": {
        "hug": "Width shrinks to the control's content or container constraints.",
        "fill": "Width expands to 100% when fullWidth=true.",
        "fixed": "Explicit width set by the consumer."
      }
    }
  },

  "tokenPolicy": {
    "allowed": ["color.fill", "color.text", "color.border", "spacing", "radius", "fontSize"],
    "forbidden": ["primitive.color"]
  },

  "a11y": {
    "role": "select (implicit native control)",
    "keyboardNav": ["Arrow keys - move between options", "Enter/Space - open or confirm", "Tab - move focus"],
    "wcag": ["1.3.1 Info and Relationships", "1.4.3 Contrast (AA)", "2.1.1 Keyboard", "2.4.7 Focus Visible", "4.1.2 Name Role Value"]
  }
}
