{
  "name": "@helixds/wc",
  "version": "0.1.0",
  "private": true,
  "description": "Helix DS — Web Components pilot (Lit + Shadow DOM). See ADR-015. Icon, Badge, Button, Tooltip only — not a full port.",
  "type": "module",
  "license": "MIT",
  "author": "Marta Conde",
  "homepage": "https://github.com/MartaCondeDesign/helixds/tree/main/packages/wc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartaCondeDesign/helixds.git",
    "directory": "packages/wc"
  },
  "bugs": {
    "url": "https://github.com/MartaCondeDesign/helixds/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "dev": "tsup src/index.ts --format esm --dts --out-dir dist --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@helixds/tokens": "workspace:*",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "*"
  }
}
