{
  "name": "@helixds/eslint-plugin",
  "version": "0.1.0",
  "description": "Real-time lint rules for Helix DS \u2014 canonical props, semantic color tokens and Helix components over native controls",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "test": "node --test test/*.test.js"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "types": "./src/index.d.ts"
}
