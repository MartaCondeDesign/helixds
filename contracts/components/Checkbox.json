{
  "$schema": "../component.schema.json",
  "name": "Checkbox",
  "version": "0.1.0",
  "status": "stable",
  "purpose": "Lets users select one or more independent options from a set, or confirm a single binary choice.",
  "import": "import { Checkbox } from '@helixds/react';",
  "neverUseFor": [
    "Multiple mutually exclusive choices \u2014 use RadioGroup instead",
    "A single on/off setting applied immediately \u2014 use Switch instead",
    "Triggering an action \u2014 use Button instead"
  ],
  "rationale": "Checkbox wraps a native <input type='checkbox'> so Space-to-toggle, focus and the checked state come from the browser. It deliberately has one fixed 16px control and no size prop \u2014 it does not follow the ADR-004 field scale, because a selection mark doesn't need density variants and a single size keeps forms visually consistent.",
  "governance": {
    "mayExtendLocally": [
      "Write the label and helper text per usage",
      "Control the checked/indeterminate state from product logic"
    ],
    "mustEscalateToDS": [
      "Adding a size prop or new control sizes",
      "Replacing the native input with a styled div",
      "Changing the checkmark, border or fill tokens"
    ]
  },
  "states": {
    "intrinsic": [
      "hover",
      "focus",
      "active"
    ],
    "authored": [
      {
        "name": "disabled",
        "description": "The checkbox is non-interactive.",
        "aria": "disabled (native HTML attribute)"
      },
      {
        "name": "invalid",
        "description": "The checkbox value fails validation.",
        "aria": "aria-invalid='true'"
      },
      {
        "name": "required",
        "description": "The checkbox must be checked before form submission.",
        "aria": "aria-required='true'"
      },
      {
        "name": "indeterminate",
        "description": "Mixed state \u2014 neither fully checked nor unchecked (e.g. a 'select all' controlling a partial selection).",
        "aria": "indeterminate is a native DOM property, not an HTML attribute \u2014 set imperatively via ref"
      }
    ]
  },
  "anatomy": [
    {
      "part": "checkbox-root",
      "element": "div",
      "description": "Layout wrapper for the control, label, and messages."
    },
    {
      "part": "checkbox-label",
      "element": "label",
      "description": "Wraps the native input, visual control, and text."
    },
    {
      "part": "checkbox-input",
      "element": "input",
      "description": "The native checkbox input. Visually styled via sibling selector, not hidden."
    },
    {
      "part": "checkbox-control",
      "element": "span",
      "description": "Visual box \u2014 reflects checked/indeterminate state via CSS.",
      "optional": false
    },
    {
      "part": "checkbox-indicator",
      "element": "slot",
      "description": "Check or minus icon inside the control."
    },
    {
      "part": "checkbox-text",
      "element": "span",
      "description": "Visible label text."
    },
    {
      "part": "checkbox-required",
      "element": "span",
      "optional": true,
      "description": "The required indicator (*), text/danger, 2px (spacing/3xs) after the label \u2014 shown by `required`."
    },
    {
      "part": "checkbox-description",
      "element": "span",
      "description": "Helper text below the control. Sits exactly 8px below it \u2014 see .ai/maps/patterns/form-field-spacing.md.",
      "optional": true
    },
    {
      "part": "checkbox-error",
      "element": "span",
      "description": "Error text shown when invalid=true.",
      "optional": true
    }
  ],
  "props": [
    {
      "name": "label",
      "type": "string",
      "required": true,
      "description": "Visible label text."
    },
    {
      "name": "description",
      "type": "string | undefined",
      "description": "Helper text shown below the control."
    },
    {
      "name": "errorMessage",
      "type": "string | undefined",
      "description": "Error text shown when invalid=true."
    },
    {
      "name": "checked",
      "type": "boolean | undefined",
      "description": "Controlled checked state."
    },
    {
      "name": "defaultChecked",
      "type": "boolean | undefined",
      "description": "Uncontrolled initial checked state."
    },
    {
      "name": "onChange",
      "type": "((checked: boolean) => void) | undefined",
      "description": "Checked-state change handler."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "description": "Non-interactive state."
    },
    {
      "name": "required",
      "type": "boolean",
      "default": false,
      "description": "Marks the field as required."
    },
    {
      "name": "invalid",
      "type": "boolean",
      "default": false,
      "description": "Shows error styling and message."
    },
    {
      "name": "indeterminate",
      "type": "boolean",
      "default": false,
      "description": "Renders the mixed/indeterminate visual state."
    },
    {
      "name": "id",
      "type": "string | undefined",
      "description": "Optional id override."
    },
    {
      "name": "name",
      "type": "string | undefined",
      "description": "Native form field name."
    },
    {
      "name": "value",
      "type": "string | undefined",
      "description": "Native form field value."
    }
  ],
  "sizing": {
    "height": {
      "mode": "fixed",
      "values": {
        "default": 16
      },
      "unit": "px",
      "note": "No size prop exists \u2014 Checkbox has one fixed control size (--helix-checkbox-size, 16px). Unlike Input/Select/Textarea, it does not follow the ADR-004 field scale."
    },
    "width": {
      "default": "hug"
    }
  },
  "tokenPolicy": {
    "allowed": [
      "color.fill",
      "color.text",
      "color.border",
      "spacing",
      "radius",
      "fontSize"
    ],
    "forbidden": [
      "primitive.color"
    ]
  },
  "a11y": {
    "role": "checkbox (native input)",
    "keyboardNav": [
      "Space \u2014 toggles checked state",
      "Tab \u2014 moves focus"
    ],
    "wcag": [
      "2.1.1 Keyboard",
      "2.4.7 Focus Visible",
      "4.1.2 Name Role Value"
    ],
    "applied": {
      "nativeElement": "div",
      "focus": [
        {
          "part": "checkbox-input",
          "when": ":focus-visible",
          "outline": "2px solid var(--helix-checkbox-border-focus)",
          "outline-offset": "2px"
        }
      ],
      "aria": {
        "checkbox-control": {
          "aria-hidden": [
            "true"
          ]
        },
        "checkbox-input": {
          "aria-invalid": [
            "true"
          ],
          "aria-describedby": [
            "(id)"
          ],
          "aria-required": [
            "true"
          ]
        },
        "checkbox-error": {
          "role": [
            "alert"
          ]
        },
        "checkbox-text": {
          "aria-hidden": [
            "true"
          ]
        }
      },
      "announced": [
        "checkbox \"Default\"",
        "checkbox \"Checked\" [checked]",
        "checkbox \"Indeterminate\" [checked=mixed]",
        "checkbox \"Disabled unchecked\" [disabled]",
        "checkbox \"Disabled checked\" [checked] [disabled]"
      ],
      "contrast": {
        "checkbox-text": {
          "light": "17.85:1 \u2014 #0f172a on #ffffff",
          "dark": "16.29:1 \u2014 #f1f5f9 on #0f172a"
        },
        "checkbox-error": {
          "light": "6.47:1 \u2014 #b91c1c on #ffffff",
          "dark": "12.65:1 \u2014 #fecdd3 on #0f172a"
        },
        "checkbox-description": {
          "light": "7.57:1 \u2014 #475569 on #ffffff",
          "dark": "6.96:1 \u2014 #94a3b8 on #0f172a"
        }
      },
      "targetSize": {
        "checkbox-input": "smallest 71\u00d721 px"
      },
      "motion": [
        "CSS transitions/animations: neutralised by the global prefers-reduced-motion rule"
      ]
    },
    "results": {
      "score": 100,
      "meetsMinimum": true,
      "checks": {
        "contract": "pass",
        "keys": "pass",
        "focus-return": "n/a",
        "keyboard": "pass",
        "axe": "pass",
        "contrast": "pass",
        "focus-visible": "pass",
        "target-size": "pass",
        "reflow": "n/a",
        "screen-reader": "pass",
        "ai-visual": "pass",
        "human": "pending"
      },
      "notScored": [
        "ai-visual",
        "human"
      ],
      "changed": "2026-10-12"
    }
  },
  "figma": {
    "states": [
      "default",
      "hover",
      "focus"
    ],
    "properties": [
      {
        "name": "state",
        "type": "VARIANT",
        "values": [
          "default",
          "hover",
          "focus"
        ],
        "figmaOnly": true,
        "description": "Figma-only axis: hover/focus are CSS pseudo-classes in code. invalid, disabled, checked and indeterminate are their own false/true toggles (figma.propertyMap, root CLAUDE.md rule 16)."
      },
      {
        "name": "indeterminate",
        "type": "VARIANT",
        "values": [
          "false",
          "true"
        ],
        "codeProp": "indeterminate",
        "description": "Shown when checked is false or true alike in code; the mark is a minus and the box fills like checked."
      }
    ],
    "propertyMap": {
      "label": {
        "codeType": "string",
        "figma": [
          {
            "name": "label",
            "type": "TEXT"
          }
        ],
        "approved": "2026-10-20"
      },
      "description": {
        "codeType": "string | undefined",
        "figma": [
          {
            "name": "description",
            "type": "BOOLEAN"
          },
          {
            "name": "description text",
            "type": "TEXT"
          }
        ],
        "approved": "2026-10-20"
      },
      "errorMessage": {
        "codeType": "string | undefined",
        "figma": [
          {
            "name": "errorMessage",
            "type": "BOOLEAN"
          },
          {
            "name": "errorMessage text",
            "type": "TEXT"
          }
        ],
        "approved": "2026-10-20"
      },
      "checked": {
        "codeType": "boolean | undefined",
        "figma": [
          {
            "name": "checked",
            "type": "VARIANT",
            "values": [
              "false",
              "true"
            ]
          }
        ],
        "approved": "2026-10-20"
      },
      "defaultChecked": {
        "codeType": "boolean | undefined",
        "figma": [],
        "approved": "2026-10-20"
      },
      "onChange": {
        "codeType": "((checked: boolean) => void) | undefined",
        "figma": [],
        "approved": "2026-10-20"
      },
      "disabled": {
        "codeType": "boolean",
        "figma": [
          {
            "name": "disabled",
            "type": "VARIANT",
            "values": [
              "false",
              "true"
            ]
          }
        ],
        "approved": "2026-10-20"
      },
      "required": {
        "codeType": "boolean",
        "figma": [
          {
            "name": "required",
            "type": "BOOLEAN"
          }
        ],
        "approved": "2026-10-20"
      },
      "invalid": {
        "codeType": "boolean",
        "figma": [
          {
            "name": "invalid",
            "type": "VARIANT",
            "values": [
              "false",
              "true"
            ]
          }
        ],
        "approved": "2026-10-20"
      },
      "indeterminate": {
        "codeType": "boolean",
        "figma": [
          {
            "name": "indeterminate",
            "type": "VARIANT",
            "values": [
              "false",
              "true"
            ]
          }
        ],
        "approved": "2026-10-20"
      },
      "id": {
        "codeType": "string | undefined",
        "figma": [],
