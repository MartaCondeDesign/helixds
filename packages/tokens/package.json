{
  "name": "@helix-ds/tokens",
  "version": "0.1.0",
  "description": "Helix Design System tokens — DTCG source → CSS custom properties + TypeScript constants",
  "main":    "./dist/index.js",
  "module":  "./dist/index.js",
  "types":   "./dist/index.d.ts",
  "exports": {
    ".":          { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./helix.css": "./dist/helix.css"
  },
  "files": ["dist"],
  "scripts": {
    "build":     "tsx src/build.ts",
    "dev":       "tsx --watch src/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx":        "*",
    "typescript": "*"
  }
}
